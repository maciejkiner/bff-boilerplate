# For local development (running server directly with `npm run dev`):
DATABASE_URL=postgres://user:password@localhost:5432/bff_db
# For Docker (running inside docker-compose — the DB host is the service name, not localhost):
# DATABASE_URL=postgres://user:password@db:5432/bff_db

PORT=3000

# REQUIRED: set a strong random secret (min 32 chars). Server refuses to start otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-32-char-minimum-secret

NODE_ENV=development

# Comma-separated list of allowed CORS origins. REQUIRED in production.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# Structured log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Maximum request body size in kilobytes (default 512 KB)
MAX_BODY_SIZE_KB=512

# Rate limiting: max requests per window per IP (default 200 req/min)
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
